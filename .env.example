# Expo runtime keys. Required for Expo web/native bundles.
EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
# Preferred for new Supabase projects.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Supported while migrating older projects.
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional public endpoint for fitness/nutrition plan search.
# Leave empty to show no imported-plan results.
EXPO_PUBLIC_FITNESS_AI_SEARCH_URL=

# Supported aliases if you are sharing config with older Next.js code.
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Do not put service-role keys, secret keys, food API keys, medication API keys,
# email keys, or other secrets in Expo public environment variables.
# See .env.local.example and ENVIRONMENT_VARIABLES.md for server/Edge-only keys.

# Supabase Edge Function/server-only AI keys. Do not prefix with EXPO_PUBLIC_.
# Configure these as Supabase secrets for deployed Edge Functions, not in Expo bundles.
OPENAI_API_KEY=
HEALTHOS_AI_MODEL=
HEALTHOS_AI_IMPORT_MODEL=
